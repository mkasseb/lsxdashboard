{
  "release": "c7ff2a86ec11fc1b3abbad18779ff7da958ffcdd",
  "workflowRun": 37884215123,
  "checkRun": 113670463972,
  "tls": "Default certificate validation; no bypass",
  "applicationHtml": "<!DOCTYPE html>\n<html lang=\"en\" data-theme=\"auto\">\n<head>\n<meta charset=\"UTF-8\">\n<meta name=\"viewport\" content=\"width=device-width, initial-scale=1.0, viewport-fit=cover\">\n<meta name=\"apple-mobile-web-app-capable\" content=\"yes\">\n<meta name=\"mobile-web-app-capable\" content=\"yes\">\n<meta name=\"apple-mobile-web-app-status-bar-style\" content=\"default\">\n<meta name=\"apple-mobile-web-app-title\" content=\"LSX\">\n<meta name=\"theme-color\" content=\"#0a0e14\">\n<link rel=\"icon\" href=\"data:image/svg+xml,%3Csvg%20xmlns%3D%22http%3A%2F%2Fwww.w3.org%2F2000%2Fsvg%22%20viewBox%3D%220%200%20100%20100%22%3E%3Cstyle%3E.bg%7Bfill%3A%231e63c9%7D%40media%28prefers-color-scheme%3Adark%29%7B.bg%7Bfill%3A%2316376b%7D%7D%3C%2Fstyle%3E%3Crect%20class%3D%22bg%22%20width%3D%22100%22%20height%3D%22100%22%20rx%3D%2222%22%2F%3E%3Cpath%20d%3D%22M59%2016%2033%2054.5h13.6L41%2084l26-38.5H53.4Z%22%20fill%3D%22%23ffcf3d%22%2F%3E%3C%2Fsvg%3E\">\n<link rel=\"apple-touch-icon\" href=\"icon-180.png\">\n<link rel=\"manifest\" href=\"manifest.webmanifest\">\n<title>LSX Dashboard \u2014 eastern Missouri &amp; southwest Illinois weather</title>\n<script>(function(){try{var t=localStorage.getItem(\"lsxTheme\")||\"auto\";if(t!==\"light\"&&t!==\"dark\")t=(window.matchMedia&&window.matchMedia(\"(prefers-color-scheme: light)\").matches)?\"light\":\"dark\";document.documentElement.setAttribute(\"data-theme\",t);}catch(e){}})();</script>\n<link rel=\"preconnect\" href=\"https://cdn.jsdelivr.net\" crossorigin>\n<link rel=\"preconnect\" href=\"https://cdnjs.cloudflare.com\" crossorigin>\n<!-- Warm the sockets for the feeds fetched immediately after paint (DNS+TLS in parallel with render) -->\n<link rel=\"preconnect\" href=\"https://api.weather.gov\" crossorigin>\n<link rel=\"preconnect\" href=\"https://opengeo.ncep.noaa.gov\">\n<link rel=\"preconnect\" href=\"https://tiles.openfreemap.org\" crossorigin>\n\n<!-- Descriptive metadata. Deliberately BELOW the preconnects: nothing here affects the first\n     paint, and the sockets above are on the critical path. The description is one sentence and\n     names the region twice \u2014 once as the office code people search for, once in plain English \u2014\n     because \"LSX\" and \"St. Louis weather\" are two different visitors arriving.\n     og-image.png is generated by tools/og-image.py; re-run it if the logo or palette changes. -->\n<meta name=\"description\" content=\"Live radar, active watches and warnings, 7-day forecasts and river gauges for the NWS St. Louis (LSX) area: eastern Missouri and southwest Illinois.\">\n<link rel=\"canonical\" href=\"https://lsxdashboard.com/\">\n<meta property=\"og:type\" content=\"website\">\n<meta property=\"og:site_name\" content=\"LSX Dashboard\">\n<meta property=\"og:url\" content=\"https://lsxdashboard.com/\">\n<meta property=\"og:title\" content=\"LSX Dashboard \u2014 eastern Missouri &amp; southwest Illinois weather\">\n<meta property=\"og:description\" content=\"Live radar, active watches and warnings, 7-day forecasts and river gauges for the NWS St. Louis (LSX) area.\">\n<meta property=\"og:image\" content=\"https://lsxdashboard.com/og-image.png\">\n<meta property=\"og:image:type\" content=\"image/png\">\n<meta property=\"og:image:width\" content=\"1200\">\n<meta property=\"og:image:height\" content=\"630\">\n<meta property=\"og:image:alt\" content=\"LSX Dashboard \u2014 live radar, watches and warnings, 7-day forecast, river gauges and climate for eastern Missouri and southwest Illinois.\">\n<meta property=\"og:locale\" content=\"en_US\">\n<meta name=\"twitter:card\" content=\"summary_large_image\">\n<meta name=\"twitter:title\" content=\"LSX Dashboard \u2014 eastern Missouri &amp; southwest Illinois weather\">\n<meta name=\"twitter:description\" content=\"Live radar, active watches and warnings, 7-day forecasts and river gauges for the NWS St. Louis (LSX) area.\">\n<meta name=\"twitter:image\" content=\"https://lsxdashboard.com/og-image.png\">\n<meta name=\"twitter:image:alt\" content=\"LSX Dashboard \u2014 live radar, watches and warnings, 7-day forecast, river gauges and climate for eastern Missouri and southwest Illinois.\">\n\n<!-- Leaflet CSS is only needed once a map initialises \u2014 load it non-blocking so the cached\n     snapshot paints immediately instead of waiting on a third-party stylesheet. -->\n<link rel=\"stylesheet\" href=\"https://cdnjs.cloudflare.com/ajax/libs/leaflet/1.9.4/leaflet.min.css\"\n  integrity=\"sha384-c6Rcwz4e4CITMbu/NBmnNS8yN2sC3cUElMEMfP3vqqKFp7GOYaaBBCqmaWBjmkjb\" crossorigin=\"anonymous\"\n  media=\"print\" onload=\"this.media='all'\">\n<link rel=\"stylesheet\" href=\"https://cdn.jsdelivr.net/npm/maplibre-gl@5.24.0/dist/maplibre-gl.css\"\n  integrity=\"sha384-uTttxo/aOKbdE5RlD/SPzSDoDmNvGlUYPjONi2MN/b7c9HPSvW07OIuyP7uL6jxK\" crossorigin=\"anonymous\"\n  media=\"print\" onload=\"this.media='all'\">\n<link rel=\"stylesheet\" href=\"/assets/dashboard.css?v=e87360cace56f657\">\n</head>\n<body>\n<!-- First focusable thing on the page, and deliberately ahead of the sprite so it stays that way.\n     Everything between the top of the document and the dashboard is one header row and a search\n     box, but a keyboard user still has to walk them on every visit. -->\n<a class=\"skip\" href=\"#main\">Skip to content</a>\n<!-- Icon sprite. Inline rather than a CDN set for three reasons: the page must keep working when a\n     CDN is unreachable (the same rule Meteocons obeys via wxiFail), an <img> cannot inherit the\n     severity colour the way a <use> can, and an inline sprite adds no origin to the CSP. One glyph\n     per CONCEPT \u2014 heat used to be drawn with a sweating face in five places and a flame in two, and\n     rain as a cloud, a droplet or an umbrella depending on which loader rendered it. Draw one with\n     the ic() helper in the script; tools/check.py fails the build if a name has no symbol here.\n\n     The interface and generic-data marks below are drawn from, or closely after, Feather\n     (https://feathericons.com, \u00a9 2013-2023 Cole Bemis, MIT) \u2014 credited in the README's licence\n     table alongside Meteocons, which the footer links. The weather-specific glyphs are original. -->\n<!-- Keep this filter renderable (not display:none) for all three browser engines. -->\n<svg aria-hidden=\"true\" focusable=\"false\" width=\"0\" height=\"0\" style=\"position:absolute;overflow:hidden\" xmlns=\"http://www.w3.org/2000/svg\"><defs>\n  <filter id=\"weatherIconOutline\" x=\"-20%\" y=\"-20%\" width=\"140%\" height=\"140%\" color-interpolation-filters=\"sRGB\">\n    <feGaussianBlur in=\"SourceAlpha\" stdDeviation=\".8\" result=\"edge\"/>\n    <feComponentTransfer in=\"edge\" result=\"edgeSolid\"><feFuncA type=\"linear\" slope=\"16\" intercept=\"-.5\"/></feComponentTransfer>\n    <feFlood flood-color=\"#526373\" result=\"edgeColor\"/>\n    <feComposite in=\"edgeColor\" in2=\"edgeSolid\" operator=\"in\" result=\"outline\"/>\n    <feMerge><feMergeNode in=\"outline\"/><feMergeNode in=\"SourceGraphic\"/></feMerge>\n  </filter>\n</defs></svg>\n<svg id=\"sprite\" aria-hidden=\"true\" xmlns=\"http://www.w3.org/2000/svg\"><defs>\n  <symbol id=\"i-sun\" viewBox=\"0 0 24 24\"><circle cx=\"12\" cy=\"12\" r=\"4\"/><path d=\"M12 2v2M12 20v2M2 12h2M20 12h2M4.9 4.9l1.4 1.4M17.7 17.7l1.4 1.4M4.9 19.1l1.4-1.4M17.7 6.3l1.4-1.4\"/></symbol>\n  <symbol id=\"i-moon\" viewBox=\"0 0 24 24\"><path d=\"M20 14.5A8.5 8.5 0 0 1 9.5 4a8.5 8.5 0 1 0 10.5 10.5z\"/></symbol>\n  <symbol id=\"i-cloud\" viewBox=\"0 0 24 24\"><path d=\"M17.5 18H7.5a4.5 4.5 0 0 1-.5-8.97 6 6 0 0 1 11.4 1.55A3.75 3.75 0 0 1 17.5 18z\"/></symbol>\n  <symbol id=\"i-rain\" viewBox=\"0 0 24 24\"><path d=\"M17.5 15H7.5a4.5 4.5 0 0 1-.5-8.97 6 6 0 0 1 11.4 1.55A3.75 3.75 0 0 1 17.5 15zM8.5 18.5l-1 3M12 18.5l-1 3M15.5 18.5l-1 3\"/></symbol>\n  <symbol id=\"i-storm\" viewBox=\"0 0 24 24\"><path d=\"M17.5 14H7.5a4.5 4.5 0 0 1-.5-8.97 6 6 0 0 1 11.4 1.55A3.75 3.75 0 0 1 17.5 14zM13 16l-2.5 3.5h3L11 23\"/></symbol>\n  <symbol id=\"i-snow\" viewBox=\"0 0 24 24\"><path d=\"M12 2v20M4.2 6.5l15.6 9M19.8 6.5L4.2 15.5\"/></symbol>\n  <symbol id=\"i-drop\" viewBox=\"0 0 24 24\"><path d=\"M12 2.7l5.66 5.65a8 8 0 1 1-11.31 0z\"/></symbol>\n  <symbol id=\"i-flood\" viewBox=\"0 0 24 24\"><path d=\"M2 8q2.5-2.5 5 0t5 0t5 0t5 0M2 14q2.5-2.5 5 0t5 0t5 0t5 0M2 20q2.5-2.5 5 0t5 0t5 0t5 0\"/></symbol>\n  <symbol id=\"i-tornado\" viewBox=\"0 0 24 24\"><path d=\"M3 4h18M5 8.5h14M7.5 13h9M10 17.5h4.5M12.5 17.5L11 22\"/></symbol>\n  <symbol id=\"i-wind\" viewBox=\"0 0 24 24\"><path d=\"M9.6 4.6A2 2 0 1 1 11 8H2M12.6 19.4A2 2 0 1 0 14 16H2M17.7 7.7A2.5 2.5 0 1 1 19.5 12H2\"/></symbol>\n  <symbol id=\"i-fog\" viewBox=\"0 0 24 24\"><path d=\"M3 9h18M6 13.5h15M3 18h13\"/></symbol>\n  <symbol id=\"i-fire\" viewBox=\"0 0 24 24\"><path d=\"M12 22a7 7 0 0 0 7-7c0-4-3-6-4.5-9.5C13.5 3.5 12 2 12 2s-1 2.5-2.5 4.5C8 9 5 11 5 15a7 7 0 0 0 7 7z\"/><path d=\"M12 22a3 3 0 0 0 3-3c0-1.8-1.5-2.7-2-4-.5 1.3-2 2.2-2 4a3 3 0 0 0 1 3z\"/></symbol>\n  <symbol id=\"i-drought\" viewBox=\"0 0 24 24\"><path d=\"M12 3.5l4.8 4.8a6.8 6.8 0 1 1-9.6 0zM4 20L20 4\"/></symbol>\n  <symbol id=\"i-heat\" viewBox=\"0 0 24 24\"><path d=\"M14 14.8V4a2.5 2.5 0 0 0-5 0v10.8a5 5 0 1 0 5 0zM11.5 17.5V7M18 6c1.2.8 1.2 1.7 0 2.5s-1.2 1.7 0 2.5M21 6c1.2.8 1.2 1.7 0 2.5s-1.2 1.7 0 2.5\"/></symbol>\n  <symbol id=\"i-cold\" viewBox=\"0 0 24 24\"><path d=\"M14 14.8V4a2.5 2.5 0 0 0-5 0v10.8a5 5 0 1 0 5 0zM11.5 17.5v-4M19 4.5v7M16 6.2l6 3.6M22 6.2l-6 3.6\"/></symbol>\n  <symbol id=\"i-uv\" viewBox=\"0 0 24 24\"><path d=\"M12 2l8 3v6c0 5-3.4 8.6-8 11-4.6-2.4-8-6-8-11V5z\"/></symbol>\n  <symbol id=\"i-air\" viewBox=\"0 0 24 24\"><path d=\"M3 9h10a2.5 2.5 0 1 0-2.5-2.5M3 15h13a2.5 2.5 0 1 1-2.5 2.5M18.4 8h.01M17.4 11.8h.01M20.6 13.4h.01\"/></symbol>\n  <symbol id=\"i-trend-down\" viewBox=\"0 0 24 24\"><path d=\"M23 18l-9.5-9.5-5 5L1 6M17 18h6v-6\"/></symbol>\n  <symbol id=\"i-walk\" viewBox=\"0 0 24 24\"><circle cx=\"13\" cy=\"4.5\" r=\"2\"/><path d=\"M13 8l-2.5 4.5L8 21M13 8l3 3 1.5 5M10.5 12.5L6 11\"/></symbol>\n  <symbol id=\"i-record\" viewBox=\"0 0 24 24\"><path d=\"M4 15s1-1 4-1 5 2 8 2 4-1 4-1V3s-1 1-4 1-5-2-8-2-4 1-4 1zM4 22v-7\"/></symbol>\n  <symbol id=\"i-stats\" viewBox=\"0 0 24 24\"><path d=\"M18 20V10M12 20V4M6 20v-6\"/></symbol>\n  <symbol id=\"i-alert\" viewBox=\"0 0 24 24\"><path d=\"M10.3 3.9L1.8 18a2 2 0 0 0 1.7 3h17a2 2 0 0 0 1.7-3L13.7 3.9a2 2 0 0 0-3.4 0zM12 9v4M12 17h.01\"/></symbol>\n  <symbol id=\"i-info\" viewBox=\"0 0 24 24\"><circle cx=\"12\" cy=\"12\" r=\"10\"/><path d=\"M12 16v-4M12 8h.01\"/></symbol>\n  <symbol id=\"i-check\" viewBox=\"0 0 24 24\"><path d=\"M20 6L9 17l-5-5\"/></symbol>\n  <symbol id=\"i-target\" viewBox=\"0 0 24 24\"><circle cx=\"12\" cy=\"12\" r=\"9\"/><circle cx=\"12\" cy=\"12\" r=\"3.5\"/><path d=\"M22 12h-3M5 12H2M12 5V2M12 22v-3\"/></symbol>\n  <symbol id=\"i-pin\" viewBox=\"0 0 24 24\"><path d=\"M21 10c0 7-9 13-9 13s-9-6-9-13a9 9 0 0 1 18 0z\"/><circle cx=\"12\" cy=\"10\" r=\"3\"/></symbol>\n  <symbol id=\"i-close\" viewBox=\"0 0 24 24\"><path d=\"M18 6L6 18M6 6l12 12\"/></symbol>\n  <symbol id=\"i-expand\" viewBox=\"0 0 24 24\"><path d=\"M8 3H5a2 2 0 0 0-2 2v3m18 0V5a2 2 0 0 0-2-2h-3m0 18h3a2 2 0 0 0 2-2v-3M3 16v3a2 2 0 0 0 2 2h3\"/></symbol>\n  <symbol id=\"i-play\" viewBox=\"0 0 24 24\"><path d=\"M6 3.5l14 8.5-14 8.5z\" fill=\"currentColor\" stroke-linejoin=\"round\"/></symbol>\n  <symbol id=\"i-pause\" viewBox=\"0 0 24 24\"><path d=\"M7 4h3v16H7zM14 4h3v16h-3z\" fill=\"currentColor\"/></symbol>\n  <symbol id=\"i-lock\" viewBox=\"0 0 24 24\"><rect x=\"3.5\" y=\"10.5\" width=\"17\" height=\"11\" rx=\"2\"/><path d=\"M7.5 10.5V7a4.5 4.5 0 0 1 9 0v3.5\"/></symbol>\n  <symbol id=\"i-doc\" viewBox=\"0 0 24 24\"><path d=\"M14 2H6a2 2 0 0 0-2 2v16a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2V8zM14 2v6h6M16 13H8M16 17H8M10 9H8\"/></symbol>\n  <symbol id=\"i-plane\" viewBox=\"0 0 24 24\"><path d=\"M22 2L11 13M22 2l-7 20-4-9-9-4z\"/></symbol>\n  <symbol id=\"i-bolt\" viewBox=\"0 0 24 24\"><path d=\"M13 2L3 14h9l-1 8 10-12h-9z\"/></symbol>\n  <symbol id=\"i-theme-auto\" viewBox=\"0 0 24 24\"><circle cx=\"12\" cy=\"12\" r=\"9\"/><path d=\"M12 3a9 9 0 0 1 0 18z\" fill=\"currentColor\"/></symbol>\n</defs></svg>\n<div id=\"wxbg\" aria-hidden=\"true\"><i class=\"b1\"></i><i class=\"b2\"></i></div>\n\n<!-- <header> is the banner landmark: who this is and where it's reporting from, plus the control\n     that changes \"where\". The old markup put .top itself on the <header>, which left the location\n     bar sitting between two landmarks belonging to neither. -->\n<header>\n<div class=\"top\">\n  <div class=\"brand\">\n    <!-- No aria-label. It is prohibited on a bare <div> (no role for it to name), and it was\n         announcing the brand a second time immediately before the <h1> that says it. The mark\n         is decorative here: the inner <svg> is already aria-hidden. -->\n    <div class=\"logo\">\n      <!-- The bolt is CUT OUT of the radar rather than laid on top of it. Stacked, the two read as\n           two unrelated pictures fighting for the same 44px \u2014 rings saying \"radar\", a bolt saying\n           \"storm\", and the bolt simply occluding the rings. Knocked out with a clearance gap, they\n           read as one object, and the gap does the separating that an outline used to do badly.\n           #lgmask's black stroke IS that gap: widen the stroke to widen the halo. -->\n      <svg viewBox=\"0 0 44 44\" width=\"44\" height=\"44\" role=\"img\" aria-hidden=\"true\">\n        <defs>\n          <linearGradient id=\"lgbg\" x1=\"0\" y1=\"0\" x2=\"0\" y2=\"1\">\n            <stop class=\"lg-bg1\" offset=\"0\"/><stop class=\"lg-bg2\" offset=\"1\"/>\n          </linearGradient>\n          <radialGradient id=\"lgsweep\" cx=\"50%\" cy=\"50%\" r=\"50%\">\n            <stop class=\"lg-sweep-stop\" offset=\".15\" stop-opacity=\".5\"/><stop class=\"lg-sweep-stop\" offset=\"1\" stop-opacity=\"0\"/>\n          </radialGradient>\n          <mask id=\"lgmask\">\n            <rect width=\"44\" height=\"44\" fill=\"#fff\"/>\n            <path d=\"M26 7 14.5 24H20.5L18 37 29.5 20H23.5Z\" fill=\"#000\" stroke=\"#000\" stroke-width=\"2.6\" stroke-linejoin=\"round\"/>\n          </mask>\n        </defs>\n        <rect width=\"44\" height=\"44\" rx=\"11\" fill=\"url(#lgbg)\"/>\n        <g mask=\"url(#lgmask)\">\n          <g class=\"lg-rings\" fill=\"none\" stroke-width=\"1.5\">\n            <circle cx=\"22\" cy=\"22\" r=\"15\" opacity=\".34\"/>\n            <circle cx=\"22\" cy=\"22\" r=\"10\" opacity=\".46\"/>\n            <circle cx=\"22\" cy=\"22\" r=\"5\" opacity=\".58\"/>\n          </g>\n          <path class=\"lg-sweep\" d=\"M22 22 22 7A15 15 0 0 0 7.6 16.9Z\" fill=\"url(#lgsweep)\"/>\n        </g>\n        <path class=\"lg-bolt\" d=\"M26 7 14.5 24H20.5L18 37 29.5 20H23.5Z\"/>\n      </svg>\n    </div>\n    <div>\n      <h1>LSX <span class=\"brand-word\">Dashboard</span></h1>\n      <!-- Where, in plain English. \"NWS LSX County Warning Area\" is exact and tells a stranger\n           nothing; LSX in the title already carries the office reference for anyone who knows it.\n           No institutional noun on the end \u2014 this is not an NWS operation and the subtitle is the\n           first thing that would imply otherwise. -->\n      <div class=\"sub\">Eastern Missouri and Southwest Illinois Weather</div>\n    </div>\n  </div>\n  <span class=\"locNow\" id=\"locNow\"></span>\n  <div class=\"header-right\">\n    <button class=\"refresh-btn\" id=\"refresh\" title=\"Refresh everything now\">\n      <span class=\"dot\" id=\"statusDot\" data-state=\"loading\"></span><span id=\"refreshLabel\">Refresh</span>\n    </button>\n    <button id=\"themeBtn\" title=\"Theme: auto (tap to change)\" aria-label=\"Toggle light/dark theme\"><svg class=\"ic\" aria-hidden=\"true\"><use href=\"#i-theme-auto\"/></svg></button>\n    <div class=\"clock\">\n      <div class=\"time\" id=\"clock\">--:--</div>\n      <div class=\"date\" id=\"cdate\">&mdash;</div>\n    </div>\n  </div>\n</div>\n\n<div class=\"locbar\">\n  <button id=\"geoBtn\" title=\"Use my current location\" aria-label=\"Use my current location\"><svg class=\"ic\" aria-hidden=\"true\"><use href=\"#i-pin\"/></svg><span class=\"g-txt\">My location</span></button>\n  <form id=\"locForm\" class=\"locsearch\" autocomplete=\"off\">\n    <input id=\"locSearch\" type=\"search\" placeholder=\"Search an LSX-area city or town\u2026\" autocomplete=\"off\" aria-label=\"Search a location in the St. Louis (LSX) forecast area\" enterkeyhint=\"search\"\n           role=\"combobox\" aria-expanded=\"false\" aria-controls=\"locSug\" aria-autocomplete=\"list\">\n    <div id=\"locSug\" class=\"locsug\" role=\"listbox\" aria-label=\"Location suggestions\"></div>\n  </form>\n</div>\n<details id=\"locationTools\" class=\"disclosure location-tools\">\n  <summary>Saved locations &amp; sharing</summary>\n  <div class=\"loc-actions\">\n    <button type=\"button\" id=\"favoriteToggle\" aria-pressed=\"false\">Save this location</button>\n    <label for=\"favoriteSelect\">Favorites</label>\n    <select id=\"favoriteSelect\"><option value=\"\">Choose a saved location</option></select>\n    <button type=\"button\" id=\"favoriteRemove\" disabled>Remove selected favorite</button>\n    <button type=\"button\" id=\"shareLocation\">Copy location link</button>\n  </div>\n  <input id=\"locationLink\" type=\"url\" readonly aria-label=\"Shareable link for the selected location\">\n  <p>City searches use a representative town point. Use My location for more precise warning-polygon checks. Always follow official NWS warnings for your area.</p>\n</details>\n<div id=\"locFeedback\" role=\"status\" aria-live=\"polite\"></div>\n</header>\n\n<!-- Jump links. The wrapper stays a direct child of <body> so it can stick after the header has\n     scrolled away. The links keep their native horizontal scrolling; edge buttons appear only\n     when a phone-width bar has more sections in that direction. -->\n<div class=\"jump-wrap\">\n<div class=\"sticky-context\"><a id=\"stickyLocation\" href=\"#locForm\" aria-label=\"Change selected forecast location\">Lake St. Louis, MO</a><span class=\"sticky-kind\" id=\"stickyKind\">Town point</span></div>\n<nav class=\"jump\" id=\"jumpNav\" aria-label=\"Jump to a section\">\n  <a href=\"#alertsCard\">Alerts</a>\n  <a href=\"#currentCard\">Now</a>\n  <a href=\"#h24Card\">Hourly</a>\n  <a href=\"#radarCard\">Radar</a>\n  <a href=\"#forecastCard\">7-Day</a>\n  <a href=\"#riversCard\">Rivers</a>\n  <a href=\"#climateCard\">Climate</a>\n</nav>\n<button class=\"jump-step jump-prev\" type=\"button\" aria-label=\"Scroll sections left\">\u2039</button>\n<button class=\"jump-step jump-next\" type=\"button\" aria-label=\"Scroll sections right\">\u203a</button>\n</div>\n\n<main id=\"main\" tabindex=\"-1\">\n\n<div id=\"snapBar\" class=\"snapbar\"><span class=\"sb-spin\"></span><span id=\"snapBarText\"></span></div>\n\n\n<div class=\"grid redesign-grid\">\n<section class=\"card  bannered\" id=\"alertsCard\">\n    <h2>Active Watches, Warnings &amp; Advisories \u2014 <span id=\"alertsScope\">LSX</span></h2>\n    <p id=\"alertUpdateNote\" class=\"feed-status\" data-state=\"unavailable\" role=\"status\" hidden></p>\n    <div id=\"alerts\"><div class=\"loading\">Loading alerts\u2026</div></div>\n  </section>\n<div id=\"mcd\"></div>\n<div class=\"weather-hero\">\n<section class=\"card hero\" id=\"currentCard\">\n      <h2>Now <span class=\"sr\" id=\"railNowSub\"></span><span class=\"link\" id=\"ccStation\">&mdash;</span></h2>\n      <div id=\"current\"><div class=\"loading\">Loading\u2026</div></div>\n    </section>\n<section class=\"card \" id=\"callCard\">\n    <div class=\"call-head\">\n      <h2 id=\"keyMessagesTitle\">NWS Local Forecast</h2>\n      <a class=\"link\" id=\"keyDiscussionLink\" hidden target=\"_blank\" rel=\"noopener noreferrer\">Full discussion \u2197</a>\n    </div>\n    <p id=\"briefStatus\" class=\"feed-status\" data-state=\"unavailable\" role=\"status\" hidden></p>\n    <p class=\"nws-message-meta\" id=\"keyMessagesMeta\"></p>\n    <p class=\"nws-message-status\" id=\"keyMessagesStatus\" role=\"status\">Checking regional Key Messages and the local forecast\u2026</p>\n    <div class=\"callrow\" id=\"callRow\"></div>\n    <details class=\"disclosure\" id=\"briefWhy\">\n      <summary><span class=\"nws-source-arrow\" aria-hidden=\"true\">\u25b8</span>Source and freshness</summary>\n      <div id=\"briefEvidence\"></div>\n    </details>\n  </section>\n</div>\n<div class=\"planning-grid\">\n<section class=\"card \" id=\"h24Card\">\n    <div class=\"hourly-head\">\n      <h2>Plan your day <span class=\"hourly-location\" id=\"h24loc\"></span></h2>\n      <span class=\"hourly-duration\" id=\"h24Title\">Next 24 hours</span>\n      <div class=\"hourly-options\" id=\"hourlyOptions\" role=\"group\" aria-label=\"Hourly forecast duration\">\n        <button type=\"button\" data-hours=\"24\" aria-pressed=\"true\" disabled>24 hours</button>\n        <button type=\"button\" data-hours=\"48\" aria-pressed=\"false\" disabled>48 hours</button>\n        <button type=\"button\" data-hours=\"72\" aria-pressed=\"false\" disabled>72 hours</button>\n      </div>\n    </div>\n    <div class=\"precip-events\" id=\"precipEvents\"><div class=\"loading\">Loading precipitation amounts\u2026</div></div>\n    <div id=\"hourly24\"><div class=\"loading\">Loading hourly\u2026</div></div>\n    <details class=\"disclosure\" id=\"forecastTempContext\" hidden>\n      <summary>Temperature uncertainty</summary>\n      <div id=\"forecastTempBody\"></div>\n    </details>\n  </section>\n<section class=\"card hero\" id=\"radarCard\">\n    <div class=\"rs-head\">\n      <h2 id=\"skyTitle\">Local radar</h2>\n      <span class=\"rs-tabs\" id=\"rsTabs\" role=\"group\" aria-label=\"Map layers\">\n        <button type=\"button\" class=\"rs-tab on\" data-l=\"radar\" aria-pressed=\"true\">Radar</button>\n        <button type=\"button\" class=\"rs-tab on\" data-l=\"sat\" aria-pressed=\"true\">Satellite</button>\n      </span>\n      <span class=\"rs-right\">\n        <!-- \"Hide\" used to live here, next to Fullscreen. It was the other half of a toggle whose\n             two halves sat a screen apart and disagreed about which word described the state; the\n             card is permanent now, so neither half exists. -->\n        <!-- Both marks ship in the markup and CSS picks one, rather than JS rewriting a <use>\n             href: it keeps the icon in lockstep with the class that decides everything else, and\n             it keeps both symbols visibly referenced (tools/check.py fails on a sprite symbol\n             nothing points at, and an href assembled at runtime is exactly the kind of reference\n             it cannot see). This used to be the rail toggle's trick; it outlived that button. -->\n        <button type=\"button\" class=\"rs-full\" id=\"rsFull\" aria-expanded=\"false\" aria-controls=\"rsRadar\"\n          ><svg class=\"ic ic-show\" aria-hidden=\"true\"><use href=\"#i-expand\"/></svg\n          ><svg class=\"ic ic-hide\" aria-hidden=\"true\"><use href=\"#i-close\"/></svg\n          ><span class=\"rsf-t\">Fullscreen</span></button>\n        <span class=\"link\" id=\"rsLink\"><a href=\"https://radar.weather.gov/station/KLSX/standard\" target=\"_blank\" rel=\"noopener\">Official KLSX \u2197</a></span>\n      </span>\n    </div>\n    <p id=\"radarAlertNote\" class=\"feed-status\" data-state=\"unavailable\" hidden></p>\n    <div class=\"rs-view\" id=\"rsRadar\">\n      <div class=\"imgwrap maplock-wrap\">\n        <div id=\"radar\" class=\"frame\"></div>\n        <div class=\"radar-time\" id=\"radarTime\"></div>\n        <div class=\"maplock\"><button type=\"button\" class=\"maplock-pill\">Tap to interact</button></div>\n      </div>\n      <div class=\"radar-ctl\" id=\"radarCtl\">\n        <!-- No duration in the markup: setRadarBtn() writes the span the frame list ACTUALLY holds.\n             The hard-coded \"~30 minutes\" that used to live here overstated the loop at every width\n             \u2014 18 minutes on a desktop, 10 on a phone \u2014 because the frame COUNT was fixed here while\n             the sweep cadence is NWS's to change. Nothing static can stay true about that number. -->\n        <button type=\"button\" id=\"radarPlay\" aria-label=\"Play radar loop\" title=\"Play the radar loop\"><svg class=\"ic\" aria-hidden=\"true\"><use href=\"#i-play\"/></svg>Loop</button>\n        <input type=\"range\" id=\"radarSlider\" min=\"0\" max=\"0\" value=\"0\" step=\"1\" aria-label=\"Scrub radar time\">\n        <span class=\"rc-t\" id=\"radarFrameTime\"></span>\n        <!-- The .rc-load style has existed since the scrubber shipped with nothing behind it.\n             This is what it was for: a zoom makes every pooled frame refetch, and the loop holds\n             rather than stepping through blanks. Empty except while it is actually waiting. -->\n        <span class=\"rc-load\" id=\"radarLoad\"></span>\n      </div>\n      <!-- role=\"img\" collapses the whole key to its aria-label on purpose: read linearly the tick\n           words are \"light heavy hail\", which is noise. The label says the thing they mean. -->\n      <div class=\"rs-legend\" id=\"rsLegend\" role=\"img\"\n           title=\"Radar reflectivity in dBZ \u2014 how hard it is coming down\"\n           aria-label=\"Reflectivity key: green is light rain, yellow and red are heavy rain, pink and purple mean hail is likely.\">\n        <span class=\"rl-t\">Intensity</span>\n        <span class=\"rl-scale\">\n          <span class=\"rl-bar\"></span>\n          <!-- Positions are the real scale, not eyeballed spacing: the bar spans 15\u201365 dBZ, so a\n               label for D sits at (D\u221215)/50. light\u224821, heavy\u224845, hail\u224859. -->\n          <span class=\"rl-ticks\"><span style=\"left:12%\">light</span><span style=\"left:60%\">heavy</span><span style=\"left:88%\">hail</span></span>\n        </span>\n      </div>\n      <!-- Empty in the markup on purpose: syncWarnKey() fills it from the shapes actually drawn,\n           and CSS :empty removes the row when the map is clear. -->\n      <div class=\"rs-wkey\" id=\"rsWarnKey\"></div>\n    </div>\n    <div class=\"imgcap\" id=\"rsCap\"><span></span><span></span></div>\n  </section>\n<section class=\"card\" id=\"forecastCard\">\n      <h2>7-Day Forecast</h2>\n      <div class=\"daily\" id=\"daily\"><div class=\"loading\">Loading forecast\u2026</div></div>\n    </section>\n</div>\n<div class=\"railhead\"><span class=\"rail-t\">Around your area</span><span class=\"rail-s\">Local conditions, outlooks &amp; official forecast context</span></div>\n<div class=\"masonry\">\n<section class=\"card \" id=\"riversCard\">\n      <h2>River &amp; Flood Gauges \u2014 live levels <span class=\"qpfchip\" id=\"qpf7\"></span>\n        <a class=\"link\" href=\"https://water.noaa.gov/\" target=\"_blank\" rel=\"noopener\" title=\"National Water Prediction Service \u2014 NOAA\u2019s river gauge and flood forecast site\">NWPS \u2197</a>\n      </h2>\n      <div class=\"river\" id=\"rivers\"><div class=\"loading\">Loading gauges\u2026</div></div>\n    </section>\n<section class=\"card\" id=\"aqiCard\">\n      <h2>Air Quality\n        <a class=\"link\" href=\"https://gispub.epa.gov/airnow/\" target=\"_blank\" rel=\"noopener\">AirNow \u2197</a>\n      </h2>\n      <div id=\"aqi\"></div>\n    </section>\n<section class=\"card \" id=\"afdCard\">\n    <h2>NWS Forecast Details\n      <a class=\"link\" id=\"afdDiscussionLink\" target=\"_blank\" rel=\"noopener noreferrer\" hidden>Full discussion \u2197</a>\n    </h2>\n    <div id=\"afd\"><div class=\"loading\">Loading discussion\u2026</div></div>\n  </section>\n<section class=\"card\" id=\"riskCard\">\n      <h2>Risk Outlook\n        <a class=\"link\" href=\"https://www.spc.noaa.gov/products/outlook/day1otlk.html\" target=\"_blank\" rel=\"noopener\">Maps \u2197</a>\n      </h2>\n      <div id=\"spc\"><div class=\"loading\">Loading outlook\u2026</div></div>\n      <div class=\"spc-threats\" id=\"spcThreats\"><div class=\"loading\">Loading tornado, wind &amp; hail outlooks\u2026</div></div>\n      <details class=\"disclosure\" id=\"riskHelp\">\n        <summary>What do these risks mean?</summary>\n        <dl>\n          <dt>Storm outlook</dt><dd>Marginal, Slight, Enhanced, Moderate and High describe increasing severe-storm potential. The fraction is a category rank, not a probability or a warning.</dd>\n          <dt>Flood outlook</dt><dd>Marginal, Slight, Moderate and High describe flash-flood risk from excessive rainfall. River flood levels are shown separately in the gauges card.</dd>\n          <dt>Fire outlook</dt><dd>Elevated, Critical and Extremely Critical describe conditions that support rapid fire spread. Avoid outdoor burning when fire risk is elevated.</dd>\n          <dt>Severe-weather probabilities</dt><dd>The chance of a tornado, damaging storm wind or large hail within 25 miles during the stated period. A low probability still allows an event.</dd>\n          <dt>Outlooks and warnings</dt><dd>Outlooks support planning. An official NWS warning calls for action now; follow its instructions.</dd>\n        </dl>\n      </details>\n      <div class=\"imgcap\"><span id=\"spcLoc\">SPC &middot; WPC</span><span>storm &middot; flood</span></div>\n    </section>\n<section class=\"card\" id=\"hazardsCard\">\n      <h2>Hazards Outlook\n        <a class=\"link\" href=\"https://www.wpc.ncep.noaa.gov/threats/threats.php\" target=\"_blank\" rel=\"noopener noreferrer\" aria-label=\"WPC 3\u20137 days hazards outlook (opens in a new tab)\" title=\"WPC days 3\u20137 hazards outlook\">WPC 3\u20137 days \u2197</a>\n      </h2>\n      <div id=\"hazards\"><div class=\"loading\">Loading hazards\u2026</div></div>\n      <div class=\"imgcap\"><span><abbr title=\"Climate Prediction Center\">CPC</abbr>/<abbr title=\"Weather Prediction Center\">WPC</abbr> U.S. Hazards</span><span id=\"hazIssued\">days 3\u201314</span></div>\n    </section>\n<section class=\"card\" id=\"obsCard\">\n      <h2>Station Plot \u2014 Live Surface Obs\n        <a class=\"link\" href=\"https://www.weather.gov/wrh/timeseries?site=KSTL\" target=\"_blank\" rel=\"noopener\">NWS \u2197</a>\n      </h2>\n      <div class=\"stn-tools\" id=\"stnTools\">\n        <button type=\"button\" data-m=\"temp\" class=\"on\"><svg class=\"ic\" aria-hidden=\"true\"><use href=\"#i-heat\"/></svg>Temp</button>\n        <button type=\"button\" data-m=\"feels\"><svg class=\"ic\" aria-hidden=\"true\"><use href=\"#i-walk\"/></svg>Feels</button>\n        <button type=\"button\" data-m=\"dew\"><svg class=\"ic\" aria-hidden=\"true\"><use href=\"#i-drop\"/></svg>Dew</button>\n        <button type=\"button\" data-m=\"wind\"><svg class=\"ic\" aria-hidden=\"true\"><use href=\"#i-wind\"/></svg>Wind</button>\n      </div>\n      <div id=\"stnmap\" class=\"stnmap\"></div>\n      <div class=\"stn-ex\" id=\"stnEx\"></div>\n      <div class=\"imgcap\"><span>NWS &middot; regional <abbr title=\"Automated Surface Observing System \u2014 the automated weather stations at airports\">ASOS</abbr>/<abbr title=\"the routine surface weather report those stations file, usually hourly\">METAR</abbr></span><span id=\"stnAge\">tap a station for detail</span></div>\n    </section>\n<section class=\"card\" id=\"droughtCard\">\n      <h2>Drought Outlook\n        <a class=\"link\" href=\"https://www.drought.gov/\" target=\"_blank\" rel=\"noopener\">drought.gov \u2197</a>\n      </h2>\n      <div class=\"dr-tier\"><a class=\"dr-when source-link\" href=\"https://droughtmonitor.unl.edu/CurrentMap.aspx\" target=\"_blank\" rel=\"noopener noreferrer\" aria-label=\"Now \u2014 current U.S. Drought Monitor (opens in a new tab)\">Now <span aria-hidden=\"true\">\u2197</span></a><span id=\"drNow\"><span class=\"dr-load\">\u2026</span></span></div>\n      <div class=\"dr-tier\"><a class=\"dr-when source-link\" href=\"https://www.cpc.ncep.noaa.gov/products/expert_assessment/mdo_summary.php\" target=\"_blank\" rel=\"noopener noreferrer\" aria-label=\"Month ahead \u2014 CPC monthly drought outlook (opens in a new tab)\">Month ahead <span aria-hidden=\"true\">\u2197</span></a><span id=\"drMonth\"><span class=\"dr-load\">\u2026</span></span></div>\n      <div class=\"dr-tier\"><a class=\"dr-when source-link\" href=\"https://www.cpc.ncep.noaa.gov/products/expert_assessment/sdo_summary.php\" target=\"_blank\" rel=\"noopener noreferrer\" aria-label=\"Season (3 mo) \u2014 CPC seasonal drought outlook (opens in a new tab)\">Season <span class=\"dr-sub\">(3 mo)</span> <span aria-hidden=\"true\">\u2197</span></a><span id=\"drSeason\"><span class=\"dr-load\">\u2026</span></span></div>\n      <div class=\"imgcap\"><span><abbr title=\"U.S. Drought Monitor \u2014 the weekly national drought map\">USDM</abbr> &middot; <abbr title=\"Climate Prediction Center\">CPC</abbr> outlooks</span><span><abbr title=\"National Integrated Drought Information System\">NIDIS</abbr> / drought.gov</span></div>\n    </section>\n<section class=\"card\" id=\"climateCard\">\n      <h2>Climate vs Normal\n        <a class=\"link\" href=\"https://xmacis.rcc-acis.org/\" target=\"_blank\" rel=\"noopener\" title=\"Applied Climate Information System \u2014 the NOAA regional climate centers\u2019 station archive\">ACIS \u2197</a>\n      </h2>\n      <div id=\"cnToday\" class=\"cn-today\"><span class=\"cn-na\">Normals loading\u2026</span></div>\n      <div id=\"cnGrid\" class=\"cn-grid\"><div class=\"loading\">Loading departures\u2026</div></div>\n      <div id=\"cnSrc\" class=\"cn-src\"></div>\n      <div id=\"cnCtx\" class=\"cn-ctx\"></div>\n      <div class=\"imgcap\"><span>Station: <span id=\"cnStation\">\u2026</span></span><span title=\"The 30-year averages NOAA compares today against, recomputed each decade\">1991\u20132020 normals</span></div>\n    </section>\n<section class=\"card\" id=\"cpcCard\">\n      <h2>Week Ahead Leanings\n        <a class=\"link\" href=\"https://www.cpc.ncep.noaa.gov/products/predictions/610day/\" target=\"_blank\" rel=\"noopener noreferrer\" aria-label=\"CPC 6\u201310 day maps (opens in a new tab)\" title=\"CPC 6\u201310 day temperature and precipitation outlooks\">6\u201310 day maps \u2197</a>\n      </h2>\n      <div id=\"cpc\"><div class=\"loading\">Loading outlooks\u2026</div></div>\n      <div class=\"imgcap\"><span>Climate Prediction Center</span><span>6\u201314 days out</span></div>\n    </section>\n<section class=\"card\" id=\"linksCard\">\n      <h2>Deep-Dive Links</h2>\n      <div class=\"quicklinks\">\n        <a href=\"https://forecast.weather.gov/product.php?site=LSX&issuedby=LSX&product=AFD&format=CI&glossary=1\" target=\"_blank\" rel=\"noopener\"><svg class=\"ic\" aria-hidden=\"true\"><use href=\"#i-doc\"/></svg>Forecast Discussion (<abbr title=\"Area Forecast Discussion \u2014 the forecasters\u2019 own written reasoning\">AFD</abbr>)</a>\n        <a href=\"https://www.spc.noaa.gov/exper/mesoanalysis/\" target=\"_blank\" rel=\"noopener\"><svg class=\"ic\" aria-hidden=\"true\"><use href=\"#i-stats\"/></svg>SPC Mesoanalysis</a>\n        <a href=\"https://www.wpc.ncep.noaa.gov/qpf/qpf2.shtml\" target=\"_blank\" rel=\"noopener\"><svg class=\"ic\" aria-hidden=\"true\"><use href=\"#i-rain\"/></svg><abbr title=\"Weather Prediction Center\">WPC</abbr> Precip (<abbr title=\"Quantitative Precipitation Forecast \u2014 how much rain or melted snow is expected, not just whether\">QPF</abbr>)</a>\n        <a href=\"https://map.blitzortung.org/#7/38.7/-90.4\" target=\"_blank\" rel=\"noopener\"><svg class=\"ic\" aria-hidden=\"true\"><use href=\"#i-bolt\"/></svg>Live Lightning</a>\n        <a href=\"https://droughtmonitor.unl.edu/CurrentMap/StateDroughtMonitor.aspx?MO\" target=\"_blank\" rel=\"noopener\"><svg class=\"ic\" aria-hidden=\"true\"><use href=\"#i-drought\"/></svg>Drought Monitor</a>\n        <a href=\"https://www.weather.gov/lsx/climate\" target=\"_blank\" rel=\"noopener\"><svg class=\"ic\" aria-hidden=\"true\"><use href=\"#i-record\"/></svg>Climate &amp; Records</a>\n        <a href=\"https://aviationweather.gov/gfa/#obs\" target=\"_blank\" rel=\"noopener\"><svg class=\"ic\" aria-hidden=\"true\"><use href=\"#i-plane\"/></svg>Aviation Weather</a>\n        <a href=\"https://www.weather.gov/lsx/winter\" target=\"_blank\" rel=\"noopener\"><svg class=\"ic\" aria-hidden=\"true\"><use href=\"#i-snow\"/></svg>Winter Weather</a>\n        <a href=\"https://water.noaa.gov/#@=-90.3,38.6,7\" target=\"_blank\" rel=\"noopener\"><svg class=\"ic\" aria-hidden=\"true\"><use href=\"#i-flood\"/></svg>Flood Map</a>\n      </div>\n    </section>\n</div>\n</div>\n</main>\n\n<!-- The canonical attribution table lives in the README's licence section. On-page data credits\n     name Open-Meteo and its upstream air-quality and geocoding sources, with a data-licence link.\n     Basemap credits sit on each map; the severe-weather disclaimer stays visible here. -->\n<footer>\n  Data: NOAA / National Weather Service (public domain) \u00b7 air quality, UV &amp; geocoding by <a href=\"https://open-meteo.com/\" target=\"_blank\" rel=\"noopener\">Open-Meteo</a> (<a href=\"https://creativecommons.org/licenses/by/4.0/\" target=\"_blank\" rel=\"noopener\">CC BY 4.0</a>).<br>\n  Air quality based on <a href=\"https://atmosphere.copernicus.eu/\" target=\"_blank\" rel=\"noopener\">Copernicus Atmosphere Monitoring Service (CAMS)</a> \u00b7 location data from <a href=\"https://www.geonames.org/\" target=\"_blank\" rel=\"noopener\">GeoNames</a> \u00b7 basemaps credited on each map.<br>\n  Open source under MIT \u2014 <a href=\"https://github.com/mkasseb/lsxdashboard\" target=\"_blank\" rel=\"noopener\">github.com/mkasseb/lsxdashboard</a>, with full data &amp; icon credits in the <a href=\"https://github.com/mkasseb/lsxdashboard#license\" target=\"_blank\" rel=\"noopener\">README</a>.<br>\n  Not an official NWS product. During severe weather, always defer to official warnings &amp; a NOAA Weather Radio.<br>\n  <span id=\"lastUpdate\">&mdash;</span>\n</footer>\n\n<!-- Map dependencies are inert descriptors. The bounded loader owns their order and retries. -->\n<script type=\"application/json\" data-map-src=\"https://cdnjs.cloudflare.com/ajax/libs/leaflet/1.9.4/leaflet.min.js\"\n  integrity=\"sha384-NElt3Op+9NBMCYaef5HxeJmU4Xeard/Lku8ek6hoPTvYkQPh3zLIrJP7KiRocsxO\" crossorigin=\"anonymous\"></script>\n<script type=\"application/json\" data-map-src=\"https://cdn.jsdelivr.net/npm/maplibre-gl@5.24.0/dist/maplibre-gl.js\"\n  integrity=\"sha384-5+cfbwT0iiub6VsQAdn6yz16nr6sDiQoHx6tm4O8OVYXHYOxcffFmCJBL0dgdvGp\" crossorigin=\"anonymous\"></script>\n<script type=\"application/json\" data-map-src=\"https://cdn.jsdelivr.net/npm/@maplibre/maplibre-gl-leaflet@0.1.4/leaflet-maplibre-gl.js\"\n  integrity=\"sha384-tXYNKOHx4T02jMP7YYCtBxPIv1B5gaA5mcVPBzqMp6d7VzWzxJgI2aWF/nJLrQdS\" crossorigin=\"anonymous\"></script>\n<script src=\"/assets/weather-core.js?v=0e0c0cd0b390374b\"></script>\n<script src=\"/assets/weather-feeds.js?v=3b5010bd8ddba31d\"></script>\n<script src=\"/assets/forecast-view.js?v=146a61b5b05d825c\"></script>\n<script src=\"/assets/dashboard-context.js?v=9e972fd51f4d5fd2\"></script>\n<script src=\"/assets/forecast-range.js?v=60eb5b8c21098806\"></script>\n<script src=\"/assets/hourly-range.js?v=bb912f3f6cdce477\"></script>\n<script src=\"/assets/dashboard.js?v=5a548c2227f36551\"></script>\n</body>\n</html>\n",
